# Public frontend values only. Vite reads this directory when run outside Docker.
VITE_API_URL=http://localhost:3000/api
VITE_AUTH_TRANSPORT=bearer
VITE_GOOGLE_OAUTH_ENABLED=false

# Optional real browser push; match public/firebase-messaging-sw.js to this project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
