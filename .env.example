# Application
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=notifications
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/notifications

# Redis
REDIS_URL=redis://redis:6379

# Authentication
PASSWORD_PEPPER=local-development-password-pepper-1234567890
JWT_SECRET=local-development-jwt-secret-12345678901234567890
JWT_EXPIRES_IN_SECONDS=3600

# Google OAuth is optional for the Docker quick start
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Demo account created by prisma db seed
DEMO_USER_EMAIL=demo@notifications.local
DEMO_USER_PASSWORD=Demo1234!
DEMO_SEED_DATA=true

# Safe defaults: no third-party credentials are required
EMAIL_PROVIDER=console
SMS_PROVIDER=console
PUSH_PROVIDER=console

# Resend (required only when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
EMAIL_FROM=Notifications <onboarding@resend.dev>
RESEND_WEBHOOK_SECRET=

# Twilio (required only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
TWILIO_AUTH_TOKEN=

# Firebase Admin (required only when PUSH_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
