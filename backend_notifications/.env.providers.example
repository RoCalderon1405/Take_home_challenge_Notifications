# Notification providers
# Keep console providers for local development and automated tests.
EMAIL_PROVIDER=console
SMS_PROVIDER=console
PUSH_PROVIDER=console

# Email - Resend
RESEND_API_KEY=
EMAIL_FROM=Notifications <onboarding@resend.dev>
# Signing secret of the Resend webhook configured for /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# SMS - Twilio
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Primary Account Auth Token used to validate X-Twilio-Signature callbacks.
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public base URL only. The backend appends /api/webhooks/twilio/status.
PUBLIC_API_BASE_URL=

# Push - Firebase Cloud Messaging HTTP v1
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Store the PEM key with escaped newlines when using a single-line .env value.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Authentication - Google OAuth 2.0
# Leave disabled when Google sign-in is not needed (local credentials + JWT keep working).
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI configured in Google Cloud.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
